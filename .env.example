# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your own values.
#
# .env is gitignored and is NEVER included in a shared package — it holds live
# credentials. Every key below is yours to obtain; none are shared.
# ---------------------------------------------------------------------------

# Local database: PGlite over the Postgres wire protocol. Start it with:
#   npm run db:dev
# No install required — it is Postgres compiled to WebAssembly.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres?sslmode=disable&pgbouncer=true&connection_limit=1"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres?sslmode=disable"

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# mock   — writes to the database, sends nothing. Safe default.
# gmail  — sends as you and can read replies back. Needs the OAuth pair below.
# resend — API key + verified domain. Cannot read replies.
EMAIL_ADAPTER="mock"

# ---------------------------------------------------------------------------
# Anthropic — the query strategist, pairing generator and every email writer.
# Without it the app still runs: agents fall back to marked simulated output.
#   https://console.anthropic.com
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""

# Hard ceiling on autonomous model spend, USD per month.
AGENT_MONTHLY_BUDGET_USD="50"

# ---------------------------------------------------------------------------
# Serper — Google search results as JSON. Company discovery needs this.
# 2,500 free credits, no card required.  https://serper.dev
# ---------------------------------------------------------------------------
SERPER_API_KEY=""

# ---------------------------------------------------------------------------
# Google Sheets mirror (optional)
# A service-account JSON key, kept OUTSIDE the repo so it cannot be committed.
# Create the Sheet yourself, then share it with the service account as Editor —
# service accounts have no Drive storage and cannot create one.
# ---------------------------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=""

# ---------------------------------------------------------------------------
# Gmail OAuth (optional) — sending as yourself and reading replies.
# Create a Web application OAuth client in your own Google Cloud project,
# leave it in Testing, and add yourself as a test user.
# Authorised redirect URI:  http://localhost:3000/api/gmail/callback
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Encrypts the Gmail refresh token at rest. Generate your own:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Changing it makes a connected mailbox unreadable — you would reconnect.
CREDENTIAL_SECRET=""

# ---------------------------------------------------------------------------
# Google Programmable Search — legacy, closed to new signups. Leave empty.
# ---------------------------------------------------------------------------
GOOGLE_CSE_API_KEY=""
GOOGLE_CSE_ID=""
